# =============================================================================
# MJ — muhit o'zgaruvchilari namunasi
# Bu faylni .env nomiga nusxalab, haqiqiy qiymatlar bilan to'ldiring.
# .env fayli hech qachon git'ga qo'shilmasin (.gitignore'da bor).
# =============================================================================

# --- Umumiy ---
ENVIRONMENT=development
TZ=Asia/Tashkent

# --- PostgreSQL ---
POSTGRES_USER=mj_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=mj_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Backend shu birlashtirilgan URL orqali ulanadi (asyncpg drayveri bilan)
DATABASE_URL=postgresql+asyncpg://mj_user:change_me@postgres:5432/mj_db

# --- Backend / JWT autentifikatsiya ---
SECRET_KEY=change_me_to_a_long_random_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- CORS ---
# Vergul bilan ajratilgan ruxsat etilgan originlar ro'yxati
CORS_ORIGINS=http://localhost:5173,http://localhost:80

# --- Web Push (VAPID) ---
# `npx web-push generate-vapid-keys` yoki pywebpush orqali generatsiya qilinadi
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_EMAIL=mailto:admin@example.com

# --- Telegram bot ---
TELEGRAM_BOT_TOKEN=

# --- Backend server ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# --- Frontend (build vaqtida Vite tomonidan o'qiladi) ---
# VAPID ochiq kaliti frontend tomonidan backend'ning
# GET /api/v1/push/vapid-public-key orqali dinamik olinadi — bu yerda takrorlanmaydi.
VITE_API_URL=http://localhost/api

# --- Nginx ---
NGINX_PORT=80
