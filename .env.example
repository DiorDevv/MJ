# =============================================================================
# MJ — muhit o'zgaruvchilari namunasi
# Bu faylni .env nomiga nusxalab, haqiqiy qiymatlar bilan to'ldiring.
# .env fayli hech qachon git'ga qo'shilmasin (.gitignore'da bor).
#
# MUHIM: ENVIRONMENT=development dan boshqa har qanday holatda (production'ga
# chiqarishda) POSTGRES_PASSWORD va SECRET_KEY albatta o'zgartirilishi shart —
# "change_me" qoldirilsa, backend ishga tushganda log'da ogohlantirish chiqadi
# (app/core/startup_checks.py), lekin baribir ishga tushib ketaveradi, shuning
# uchun buni unutmaslik o'zingizga bog'liq.
# =============================================================================

# --- Umumiy ---
ENVIRONMENT=development
TZ=Asia/Tashkent

# --- Proksi (internetsiz VM: Squid orqali) -----------------------------------
# Odatiy (internetli) mashinada BO'SH qoldiring — hech narsaga ta'sir qilmaydi.
# Internetsiz VM'da to'ldiring. Bu qiymatlar:
#   * `docker compose build` vaqtida backend/frontend/bot image'lariga (apt/pip/npm);
#   * backend/bot/speaches konteynerlariga RUNTIME'da ham (Telegram API,
#     Web Push, HuggingFace model) beriladi.
# Docker demoni base image'larni ALOHIDA tortadi — deploy/PROKSI-VA-VM.md ga qarang.
# NO_PROXY ga ichki compose hostlarini qo'shish SHART — aks holda backend
# bazaga (postgres:5432) ham proksi orqali ulanmoqchi bo'ladi va buziladi.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,::1,postgres,backend,frontend,bot,speaches,nginx

# --- PostgreSQL ---
POSTGRES_USER=mj_user
# XAVFSIZLIK: production'da albatta o'zgartiring, masalan: openssl rand -hex 24
POSTGRES_PASSWORD=change_me
POSTGRES_DB=mj_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Backend shu birlashtirilgan URL orqali ulanadi (asyncpg drayveri bilan).
# POSTGRES_PASSWORD ni o'zgartirsangiz, bu yerdagi parolni ham moslang.
DATABASE_URL=postgresql+asyncpg://mj_user:change_me@postgres:5432/mj_db

# --- Backend / JWT autentifikatsiya ---
# XAVFSIZLIK: production'da albatta o'zgartiring, masalan: openssl rand -hex 32
SECRET_KEY=change_me_to_a_long_random_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# Refresh-cookie'ning `Secure` bayrog'i. Bo'sh = ENVIRONMENT dan olinadi
# (development => false, aks holda true). Production'ni TLS'siz (oddiy HTTP)
# ochsangiz `false` qiling — aks holda sahifa yangilanganda tizimdan chiqib
# ketiladi. HTTPS bo'lsa `true`.
COOKIE_SECURE=

# --- Bajarilgan vazifalar retention (ixtiyoriy) ---
# Shu kundan eski bajarilgan vazifalar har kuni avtomatik o'chiriladi
# (takroriy nusxalar tez to'planadi). 0 = hech qachon o'chirmaslik.
COMPLETED_TASK_RETENTION_DAYS=0

# --- CORS ---
# Vergul bilan ajratilgan ruxsat etilgan originlar ro'yxati
CORS_ORIGINS=http://localhost:5173,http://localhost:80

# --- Web Push (VAPID) ---
# `npx web-push generate-vapid-keys` yoki pywebpush orqali generatsiya qilinadi
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_EMAIL=mailto:admin@example.com

# --- Telegram bot ---
TELEGRAM_BOT_TOKEN=
# Ovozli xabarlarni matnga o'girish — istalgan OpenAI-mos /v1/audio/transcriptions
# xizmati. Standart holatda bo'sh qoldirilsa, bot ovozli xabarni e'tiborsiz qoldirib,
# foydalanuvchidan matn bilan yozishni so'raydi.
#
# Variant A — OpenAI Whisper API (pullik, ~$0.006/daqiqa):
#   STT_BASE_URL=https://api.openai.com/v1/audio/transcriptions
#   STT_API_KEY=<https://platform.openai.com/api-keys dan olingan kalit>
#   STT_MODEL=whisper-1
#
# Variant B — o'z serveringizda (bepul, docker-compose.yml'dagi "speaches" xizmati):
STT_BASE_URL=http://speaches:8000/v1/audio/transcriptions
STT_API_KEY=
STT_MODEL=Systran/faster-whisper-small

# --- Backend server ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# --- Frontend (build vaqtida Vite tomonidan o'qiladi) ---
# VAPID ochiq kaliti frontend tomonidan backend'ning
# GET /api/v1/push/vapid-public-key orqali dinamik olinadi — bu yerda takrorlanmaydi.
VITE_API_URL=http://localhost/api

# --- Zaxira (offsite, ixtiyoriy) ---
# scripts/backup-db.sh har dumpni shu rclone remote'ga ham nusxalaydi.
# Bir marta sozlash:  rclone config   (S3 / B2 / Google Drive / SFTP ...).
# Bo'sh bo'lsa — faqat lokal backups/ papkasi (VM bilan birga yo'qoladi).
BACKUP_RCLONE_REMOTE=
# BACKUP_RCLONE_MAX_AGE=21d   # offsite'da shundan eski dumplar o'chiriladi

# --- Nginx ---
NGINX_PORT=80
