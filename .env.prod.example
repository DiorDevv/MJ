# =============================================================================
# MJ — PRODUCTION / VM konfiguratsiyasi namunasi
#
# MJ bitta `.env` faylini o'qiydi (compose'da `env_file: - .env`). Shu sabab
# VM'da bu faylni AYNAN `.env` nomiga nusxalang:
#     cp .env.prod.example .env
# so'ng CHANGE_ME larni to'ldiring va:
#     docker compose -f docker-compose.yml up -d --build
#     (aynan `-f docker-compose.yml` — bu docker-compose.override.yml ni
#      o'chiradi, ya'ni postgres/backend host'ga OCHILMAYDI, faqat nginx :8070)
#
# Eng oson: ./deploy/vm-setup.sh  — bu faylni siz uchun to'ldiradi.
# =============================================================================

# --- Umumiy ---
ENVIRONMENT=production
TZ=Asia/Tashkent

# --- Proksi (internetsiz VM: Squid orqali) -----------------------------------
# Internetli VM'da BO'SH qoldiring. Internetsiz VM'da to'ldiring — bu qiymat
# build (apt/pip/npm) VA runtime (bot->Telegram, backend->Web Push,
# speaches->HuggingFace) uchun ishlatiladi. Docker demoni base image'larni
# alohida tortadi: deploy/PROKSI-VA-VM.md.
# NO_PROXY dagi ichki hostlarni O'ZGARTIRMANG.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,::1,postgres,backend,frontend,bot,speaches,nginx

# --- PostgreSQL ---
POSTGRES_USER=mj_user
# CHANGE_ME — kuchli parol:  openssl rand -hex 24
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=mj_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Ichidagi parolni yuqoridagi POSTGRES_PASSWORD bilan BIR XIL qiling.
DATABASE_URL=postgresql+asyncpg://mj_user:CHANGE_ME_strong_db_password@postgres:5432/mj_db

# --- Backend / JWT autentifikatsiya ---
# CHANGE_ME:  openssl rand -hex 32
SECRET_KEY=CHANGE_ME_openssl_rand_hex_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# Refresh-cookie'ning `Secure` bayrog'i (faqat HTTPS orqali yuboriladi).
# HTTP orqali (masalan VM'ni IP + :8070 bilan, TLS'siz) ochsangiz — `false`
# qiling, aks holda brauzer cookie'ni saqlamaydi va har "refresh"da tizimdan
# chiqib ketasiz. Domen + HTTPS qo'ysangiz — `true`.
# Bo'sh qoldirilsa: ENVIRONMENT dan olinadi (production => secure).
COOKIE_SECURE=false

# --- CORS ---
# Brauzerdan ilova ochiladigan origin(lar). VM'ni IP orqali ochsangiz portni ham
# yozing (NGINX_PORT bilan bir xil):
#   http://<VM-IP>:8070
# Domen + HTTPS bo'lsa:  https://sizning-domen.com
CORS_ORIGINS=http://localhost:8070

# --- Web Push (VAPID) ---
# `npx web-push generate-vapid-keys` (yoki air-gap'da:
#  docker run --rm node:22-alpine npx -y web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=CHANGE_ME_vapid_public_key
VAPID_PRIVATE_KEY=CHANGE_ME_vapid_private_key
VAPID_CLAIMS_EMAIL=mailto:admin@example.com

# --- Telegram bot ---
# Token bo'lmasa qolgan tizim ishlayveradi — faqat `bot` konteyneri qayta-qayta
# qulab tushib qayta ishga tushaveradi (normal holat).
TELEGRAM_BOT_TOKEN=
# Ovoz->matn. Bo'sh qoldirilsa bot ovozli xabarni e'tiborsiz qoldiradi.
# Standart: docker-compose.yml'dagi "speaches" (bepul, o'z serverida).
STT_BASE_URL=http://speaches:8000/v1/audio/transcriptions
STT_API_KEY=
STT_MODEL=Systran/faster-whisper-small

# --- Backend server ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# --- Frontend (build vaqtida Vite ichiga "quyib qo'yiladi") ---
# `/api` — nisbiy yo'l: nginx bir xil origin ortida /api ni backendga uzatadi,
# shu sabab VM IP yoki domen o'zgarsa ham QAYTA BUILD shart emas. Faqat split-origin
# (frontend va backend boshqa domenlarda) bo'lsa to'liq URL yozing.
VITE_API_URL=/api

# --- Nginx ---
# Tashqi HTTP port. VM uchun standart 8070. Band bo'lsa boshqasini bering —
# keyin CORS_ORIGINS dagi portni ham moslang.
NGINX_PORT=8070
